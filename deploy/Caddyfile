# Caddy config for the gwave.ai app (used by deploy/docker-compose.prod.yml).
# Caddy fetches + renews a Let's Encrypt certificate automatically and reverse
# proxies HTTPS traffic to the app container. www -> apex redirect.
#
# Requires: ports 80 + 443 open on the box, and gwave.cc / www.gwave.cc DNS
# A records pointing at the box's public IP.

{
	email nyeinchanlin75@gmail.com
}

gwave.cc {
	encode gzip zstd

	# Metaverse multiplayer WebSocket, same-origin path. The client falls
	# back to wss://gwave.cc/mv/ws automatically, so no extra DNS record
	# (mv.gwave.cc) or NEXT_PUBLIC_MV_WS_URL build-arg is required.
	# handle_path strips /mv, so /mv/health -> /health on the container.
	# On the prod box (systemd Caddy) the upstream is 127.0.0.1:8090.
	handle_path /mv/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Camera Bridge HLS (deploy/cctv-bridge/): MediaMTX republishes phone-
	# relayed cameras on loopback :8888; this is their only public face.
	handle_path /hls/* {
		reverse_proxy 127.0.0.1:8888
	}

	# GWAVE STRIKE — the `strike` container serves the game client AND its
	# Colyseus matchmaking/WS on one port. Redirect the bare path so the
	# client's relative URLs resolve under /strike/.
	redir /strike /strike/ permanent
	handle_path /strike/* {
		reverse_proxy 127.0.0.1:8095
	}

	reverse_proxy web:3000
}

www.gwave.cc {
	redir https://gwave.cc{uri} permanent
}
