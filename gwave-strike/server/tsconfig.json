{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    // @colyseus/schema decorators
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
